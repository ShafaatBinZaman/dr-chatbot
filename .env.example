# Copy to .env and fill in. .env is gitignored — never commit real values.
FLASK_ENV=development
FLASK_PORT=5000

# Path to the fine-tuned seq2seq model (downloaded separately, see docs/MODELS.md)
DRCHATBOT_MODEL_PATH=./models/drchatbot-model

# Hugging Face token, only needed for gated models
HF_TOKEN=
